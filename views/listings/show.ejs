<% layout("/layouts/boilerplate.ejs") %>
<body>
    <script>
        const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>
    </script>

    <div class="row">
        <div class="col-2"></div>
        <div class="col-8 mt-1">
            <h5 class="card-text"><%= listing.title %></h5>

            <div class="card listing-card">
                <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
                <div class="card-body">
                    <div class="row">
                    <h4 class="card-text mb-3 col-6">Hosted by <%= listing.owner.username %></h4>
                    <div class="col-6" style="text-align: right;">
                    <div>
                        <i class="fa-solid fa-location-dot"></i>
                        <%= listing.location %>, <%= listing.country %>
                    </div>
                    </div>
                    </div>
                    <p style="color: #57423d;"><%= listing.description %></p>
                </div>
            </div>
        </div>
    </div>
    <div class="row mb-5">
        <div class="col-2"></div>
        <div class="col-4 mb-3">
            <h4>What this place offers at <span style="color: #6483b1;"><%= listing.price %>/night.</span></h4>
            <%  const mid = Math.ceil(listing.amenities.length / 2);
                const firstHalf = listing.amenities.slice(0, mid);
                const secondHalf = listing.amenities.slice(mid); %>
            <ul class="list-group mt-3 pt-1 ps-5">
                <div>
        
                <% firstHalf.forEach(amenity => { %>
                    <li class="list-group-item">✓ <%= amenity %></li>
                <% }) %>
                </div>
            </ul>

        </div>
        <div class="col-4 mt-5 pe-5">
            <ul class="list-group">
                <div>
        
                <% secondHalf.forEach(amenity => { %>
                    <li class="list-group-item">✓ <%= amenity %></li>
                <% }) %>
                </div>
            </ul>
        </div>
    </div>

    <div class="row mb-3">
        <% if(currUser && currUser._id.equals(listing.owner._id)) {%>
            <div class="d-flex justify-content-end mt-3 col-10" >
                <form method="get" action="/listings/<%= listing._id %>/edit">
                    <button class="btn btn-dark me-5">Edit</button>
                </form>
                
                <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="btn main-btn">Delete</button>
                </form>
            </div>
        <% } %>
    </div>

    <div class="row mb-5 p-5">
        <h4 class="mb-3 ps-5">Reviews</h4>
            <% for(let review of listing.reviews) {%>   
                <div class="col-5 rev-outer ms-5 mb-3 ps-3">
                    <div class="card-body">
                        <h5 class="card-title mb-3" style="color: #001C37;">@<%=review.author.username%></h5>
                        <p class="card-text" style="color: #57423d;"><%=review.comment%></p>
                        <p class="starability-result card-text" data-rating="<%=review.rating%>"></p>
                    </div>

                    <% if(currUser && currUser._id.equals(review.author._id)) {%>
                        <form method="post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" class="mt-3">
                            <button class="btn btn-sm btn-dark">Delete</button>
                        </form>
                    <% } %>
                </div>
            <%}%>
    </div>
    
    
            
    <% if(currUser) { %>
    <div class="row">
        <div class="mt-3 mb-3 col-6 offset-2">
            <hr>
            <h4>Leave a Review </h4>
            <form method="post" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">               
                <div class="mt-3 ms-5">
                    <label for="rating" class="form-label">Rating:</label>
                    <fieldset class="starability-grow">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>

                <div class="mb-3 ms-5">
                    <label for="comment" class="form-label">Comment:</label>
                    <textarea name="review[comment]" id="comment" class="form-control" rows="7" required></textarea>
                    <div class="invalid-feedback">comment section is empty.</div>
                </div>

                <div class="d-flex justify-content-center mt-3">
                        <button class="btn btn-primary">Submit</button>
                </div>
                
            </form>
                     
        </div>
    </div>
    <% } %>

    <hr>
    <div class="map-outer">
        <h4>Where you'll be</h4>
        <div id="map"></div>
    </div>


    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script src="/js/map.js"></script>
</body>