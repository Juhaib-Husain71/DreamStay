<% layout("/layouts/boilerplate.ejs") %>
<style>
.navbar{
    display: none;
}
.main-footer{
    display: none;
}
</style>

<div class="row">
    <div class="col" style="height: 100vh; background-image: url('https://res.cloudinary.com/fo1ewlbf/image/upload/v1784615292/wanderlust_DEV/j32dx9j6rpeghloeszgl.jpg'); background-size: contain;">
    </div>

    <div class="col d-flex justify-content-center align-items-center">
        <div class="col-8">
            <a href="/">-Back to Home</a>
            <h2 class="mt-2">Signup on DreamStay</h2>
            <p class="para-primary">You will able to get offers and deals</p>

            <form method="post" action="/users/signup" novalidate class="needs-validation">
                <div class="mb-3 mt-4">
                    <label for="username" class="form-label">Username</label>
                    <input name="username" id="username" type="text" class="form-control" required>
                    <div class="valid-feedback">username looks good</div>
                    <div class="invalid-feedback">Unique username required</div>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input name="email" id="email" type="email" class="form-control" required>
                    <div class="valid-feedback">email looks good</div>
                    <div class="invalid-feedback">Enter valid email</div>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input name="password" id="password" type="password" class="form-control" required>
                    <div class="valid-feedback">password looks good</div>
                    <div class="invalid-feedback">Enter valid password</div>
                </div>

                <div class="d-grid mt-3">
                    <button class="btn btn-primary mt-3">Signup</button>
                </div>
            </form>

            <p class="text-center mt-4">already have an account? <a href="/users/login">Login</a></p>
        </div>
    </div>
</div>